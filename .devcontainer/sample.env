## For development ##
NODE_ENV=development
MONGO_URI={mongo_db_connection_string}
JWT_SECRET=secret
PORT=5001
AUTH_COOKIE_NAME=auth_token
FRONTEND_HOST=http://localhost:3000


## For production ##
NODE_ENV=production
MONGO_URI={mongo_db_connection_string}
JWT_SECRET=secret
PORT=5001
AUTH_COOKIE_NAME=auth_token
FRONTEND_HOST=http://<frontend_ip>:8080

